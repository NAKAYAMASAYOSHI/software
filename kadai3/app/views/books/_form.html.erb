<%= form_with model: book, url: url, local: true do |f| %>
  <% if book.errors.any? %>
    <div class="error-box">
      <p><strong><%= book.errors.count %>件のエラーがあります</strong></p>
      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, 'タイトル' %>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :author, '著者' %>
    <%= f.text_field :author %>
  </div>

  <div class="field">
    <%= f.label :published_year, '出版年' %>
    <%= f.text_field :published_year %>
  </div>

  <div class="actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to 'キャンセル', books_path, class: "btn btn-secondary" %>
  </div>
<% end %>

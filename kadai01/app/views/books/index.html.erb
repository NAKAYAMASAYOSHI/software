<h1>書籍一覧</h1>

<p><%= link_to '＋ 新規追加', new_book_path, class: "btn btn-primary" %></p>

<% if @books.any? %>
  <table class="book-table">
    <thead>
      <tr>
        <th>タイトル</th>
        <th>著者</th>
        <th>出版年</th>
        <th colspan="3">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.author %></td>
          <td><%= book.published_year %></td>
          <td><%= link_to '表示', book_path(book), class: "btn btn-small" %></td>
          <td><%= link_to '編集', edit_book_path(book), class: "btn btn-small" %></td>
          <td><%= link_to '削除', book_path(book), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-small btn-danger" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">まだ書籍が登録されていません。</p>
<% end %>

<h1>ログイン</h1>

<%= form_with url: top_login_path, data: { turbo: false } do |f| %>
  <p>
    <%= f.label :uid, 'ユーザID' %>
    <%= f.text_field :uid %>
  </p>
  <p>
    <%= f.label :pass, 'パスワード' %>
    <%= f.password_field :pass %>
  </p>
  <%= f.submit 'ログイン' %>
<% end %>

<p><%= link_to 'ツイート一覧に戻る', tweets_path %></p>

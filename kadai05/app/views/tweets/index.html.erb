<h1>ツイート一覧</h1>

<% if session[:login_uid] %>
  <p>ログイン中：<%= session[:login_uid] %>
    <%= link_to 'ログアウト', top_logout_path %>
  </p>

  <%= form_with url: tweets_path do |f| %>
    <%= f.text_field :message %>
    <%= f.submit 'ツイート' %>
  <% end %>
<% else %>
  <p>
    <%= link_to 'ログイン', top_main_path %>
    <%= link_to 'ユーザ登録', new_user_path %>
  </p>
<% end %>

<hr>

<% @tweets.each do |tweet| %>
  <p>
    <strong><%= tweet.user.uid %></strong>：<%= tweet.message %>
    （いいね <%= tweet.likes.count %>）
    <% if session[:login_uid] %>
      <% if tweet.like_users.exists?(uid: session[:login_uid]) %>
        <%= link_to 'いいね削除', like_path(tweet), data: { turbo_method: :delete } %>
      <% else %>
        <%= link_to 'いいね', likes_path(tweet_id: tweet.id), data: { turbo_method: :post } %>
      <% end %>
    <% end %>
  </p>
<% end %>
